BETTER_AUTH_SECRET="secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_URL="http://localhost:3000"

# Magic link emails (production). Optional in dev (link is logged).
# RESEND_API_KEY="re_xxxx"
# RESEND_FROM_EMAIL="noreply@yourdomain.com"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dy"

# Redis (optional). Used when REDIS_URL is set. Password must match docker-compose Redis.
REDIS_PASSWORD="redispassword"
REDIS_URL="redis://:redispassword@localhost:6379"


LOYALTY_CRON_SECRET="secret"

# Cloudflare R2 (object storage)
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
