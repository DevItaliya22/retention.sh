{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "auth:generate": "npx @better-auth/cli generate --config ./src/lib/auth/auth.ts --output ../../packages/prisma/prisma/schema.prisma --yes",
    "db:generate": "pnpm --filter=@reelo/db db:generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/nextjs-monorepo-workaround-plugin": "^7.2.0",
    "@react-email/render": "^2.0.4",
    "@reelo/db": "workspace:*",
    "@reelo/transactional": "workspace:*",
    "@reelo/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.4.10",
    "framer-motion": "^12.23.26",
    "google-libphonenumber": "^3.2.44",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.6",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "resend": "^4.8.0",
    "slugify": "^1.6.6",
    "sonner": "^2.0.7",
    "swr": "^2.3.8",
    "xlsx": "^0.18.5",
    "zod": "^4.3.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@reelo/eslint-config": "workspace:*",
    "@reelo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
