model Bill {
  id String @id @default(uuid())

  billNumber            String
  amount                Float?
  notes                 String? // Optional notes on the bill
  finalAmount           Float? // Amount after applying loyalty redemption (if any)
  loyaltyPointsEarned   Int     @default(0)
  loyaltyPointsRedeemed Int     @default(0)

  businessId       String
  customerId       String
  businessCustomer BusinessCustomer @relation(fields: [businessId, customerId], references: [businessId, customerId], onDelete: Cascade)

  // Optional: which cashier created this bill
  cashierId String?
  cashier   Cashier? @relation(fields: [cashierId], references: [id], onDelete: SetNull)

  // Relation to scratch cards
  scratchCardResponses ScratchCardResponse[]

  // Loyalty: point transactions (earned/redeemed) linked to this bill
  pointsTransactions PointsTransaction[]

  lineItems BillLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, billNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([cashierId])
  @@map("bill")
}

model BillLineItem {
  id String @id @default(uuid())

  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  skuId String
  sku   Sku    @relation(fields: [skuId], references: [id], onDelete: Cascade)

  qty       Int    @default(1)
  unitPrice Float? // price at time of purchase (optional; can use sku.price)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([billId, skuId])
  @@index([billId])
  @@index([skuId])
  @@map("bill_line_item")
}
