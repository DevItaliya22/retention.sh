// ========================================================================
// BILL
// ========================================================================
// A bill represents a single purchase/transaction by a customer.
//
// Amount flow:
//   subtotal - storeDiscount + sum(tax) = finalAmount (bill total before loyalty).
//   If loyalty onFinalAmount: cashback/points calculated on finalAmount;
//   else: calculated on subtotal.
//   userPaidAmount = finalAmount - cashbackAmount (what customer actually pays).
//
// One CashbackTransaction row is created per bill when cashback is earned.
// Points earned/redeemed (for AMOUNT_SPENT/VISIT_MADE) from PointsTransaction.
// ========================================================================

model Bill {
  id String @id @default(uuid())

  billNumber String

  // ── Amounts ────────────────────────────────────────────────────────────
  // subtotal: sum of line items at billing time (before store discount/tax).
  subtotal Float?

  // Store discount (₹) applied to the bill.
  storeDiscount Float? @default(0)

  // Tax breakdown (e.g. per rate). For now empty; sum contributes to finalAmount.
  tax Int[] @default([])

  // finalAmount = subtotal - storeDiscount + sum(tax). Bill total before loyalty.
  finalAmount Float?

  // Cashback (₹) applied from loyalty. userPaidAmount = finalAmount - cashbackAmount.
  cashbackAmount Float?

  // What the customer actually pays after cashback (and points redemption).
  userPaidAmount Float?

  // Optional notes on the bill.
  notes String?

  paymentMethod String?

  // ── Relations ──────────────────────────────────────────────────────────
  businessId       String
  customerId       String
  businessCustomer BusinessCustomer @relation(fields: [businessId, customerId], references: [businessId, customerId], onDelete: Cascade)

  // Optional: which cashier created this bill.
  cashierId String?
  cashier   Cashier? @relation(fields: [cashierId], references: [id], onDelete: SetNull)

  scratchCardResponses ScratchCardResponse[]

  // Point transactions (earned/redeemed) linked to this bill. AMOUNT_SPENT / VISIT_MADE only.
  pointsTransactions PointsTransaction[]

  // Cashback transactions (one per bill when CASHBACK or TIER loyalty awards cashback).
  cashbackTransactions CashbackTransaction[]

  lineItems BillLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, billNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([cashierId])
  @@map("bill")
}

// ========================================================================
// BILL LINE ITEM
// ========================================================================
// Individual item/SKU in a bill with quantity and price snapshot.
// unitPrice captures the price at time of purchase (may differ from Sku.price
// if the price changed since).
// ========================================================================

model BillLineItem {
  id String @id @default(uuid())

  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  skuId String
  sku   Sku    @relation(fields: [skuId], references: [id], onDelete: Cascade)

  qty       Int    @default(1)
  unitPrice Float? // Price at time of purchase (optional; can fall back to sku.price)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([billId, skuId])
  @@index([billId])
  @@index([skuId])
  @@map("bill_line_item")
}
