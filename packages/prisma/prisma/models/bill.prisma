// ========================================================================
// BILL
// ========================================================================
// A bill represents a single purchase/transaction by a customer.
//
// Amount flow:
//   subtotal - storeDiscount + sum(tax) = finalAmount (bill total before loyalty).
//   cashbackRedeemedAmount = discount from wallet (prev cashback) applied this bill.
//   cashbackAmount = cashback EARNED this bill (added to wallet; not subtracted from bill).
//   userPaidAmount = finalAmount - cashbackRedeemedAmount (what customer actually pays).
//   If loyalty onFinalAmount: earning calculated on (finalAmount - cashbackRedeemedAmount);
//   else: earning calculated on subtotal.
//
// Transaction: type=EARNED/REDEEMED, source=BILL, valueKind=CASHBACK or POINTS.
// ========================================================================

model Bill {
  id String @id @default(uuid())

  billNumber String

  // ── Amounts ────────────────────────────────────────────────────────────
  // subtotal: sum of line items at billing time (before store discount/tax).
  subtotal Float?

  // Store discount (₹) applied to the bill.
  storeDiscount Float? @default(0)

  // Tax breakdown (e.g. per rate). For now empty; sum contributes to finalAmount.
  tax Int[] @default([])

  // finalAmount = subtotal - storeDiscount + sum(tax). Bill total before loyalty.
  finalAmount Float?

  // Cashback (₹) EARNED this bill (added to wallet; for display only).
  cashbackAmount Float?

  // Cashback (₹) REDEEMED from wallet as discount this bill.
  cashbackRedeemedAmount Float?

  // Discount (₹) from redeeming partner points/cashback at this bill. userPaidAmount = finalAmount - cashbackRedeemedAmount - partnerRedeemedAmount.
  partnerRedeemedAmount Float?

  // Which partner's balance was used on this bill (one partner per bill). Set when first partner redemption is applied; used for analytics and to block a second partner.
  redeemedFromPartnerBusinessId String?

  // What the customer actually pays after cashback and partner redemption.
  userPaidAmount Float?

  // Optional notes on the bill.
  notes String?

  paymentMethod String?

  // ── Relations ──────────────────────────────────────────────────────────
  businessId       String
  customerId       String
  businessCustomer BusinessCustomer @relation(fields: [businessId, customerId], references: [businessId, customerId], onDelete: Cascade)

  // Optional: which cashier created this bill.
  cashierId String?
  cashier   Cashier? @relation(fields: [cashierId], references: [id], onDelete: SetNull)

  scratchCardResponses ScratchCardResponse[]

  // One feedback link per bill (created when bill is created)
  feedbackLink FeedbackLink?

  // Unified transactions (cashback or points earned/redeemed) linked to this bill.
  transactions Transaction[]

  lineItems    BillLineItem[]
  shopifyOrder ShopifyOrder? // When this bill was created from a Shopify order

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, billNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([cashierId])
  @@map("bill")
}

// ========================================================================
// BILL LINE ITEM
// ========================================================================
// Individual item/SKU in a bill with quantity and price snapshot.
// unitPrice captures the price at time of purchase (may differ from Sku.price
// if the price changed since).
// ========================================================================

model BillLineItem {
  id String @id @default(uuid())

  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  skuId String
  sku   Sku    @relation(fields: [skuId], references: [id], onDelete: Cascade)

  qty       Int    @default(1)
  unitPrice Float? // Price at time of purchase (optional; can fall back to sku.price)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([billId, skuId])
  @@index([billId])
  @@index([skuId])
  @@map("bill_line_item")
}
