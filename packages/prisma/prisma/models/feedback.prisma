model FeedbackConfig {
  id String @id @default(uuid())

  // Global config per business (one config per business)
  businessId String?   @unique
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Branding (optional styling for feedback experience)
  brandingId String?   @unique
  branding   Branding? @relation(fields: [brandingId], references: [id], onDelete: SetNull, map: "feedback_branding_fkey")

  // Follow up messages
  positiveFollowUp String?
  negativeFollowUp String?

  // Questions & Categories
  questions  FeedbackQuestion[]
  categories FeedbackCategory[]

  // How did you hear about us?
  isHowDidYouHearEnabled Boolean               @default(true)
  howDidYouHearOptions   HowDidYouHearOption[]

  // Selection options (e.g. "What you liked / didn't like") — ordered by seq, DnD in admin
  selectionOptions FeedbackSelectionOption[]

  // Rewards (cashback credited to customer wallet on feedback submit)
  feedbackRewardEnabled Boolean @default(false)
  rewardAmount          Float? // cashback amount (₹) added to customer wallet  

  // Timing
  timing       FeedbackTiming @default(IMMEDIATELY)
  delaySeconds Int? // Active if timing is AFTER_DELAY

  // Collection Settings
  collectionChannel    FeedbackCollectionChannel @default(WHATSAPP)
  sendViaSmsIfWpFailed Boolean                   @default(false)

  // Negative Feedback Alerts
  negAlertChannelsWp    Boolean @default(false)
  negAlertChannelsSms   Boolean @default(false)
  negAlertChannelsEmail Boolean @default(false)

  negFeedbackAlertNumber       String?
  negFeedbackAlertSmsNumber    String?
  negFeedbackAlertEmailAddress String?

  // Online Reviews
  askForOnlineReviews  Boolean               @default(false)
  onlineReviewLink     String?
  onlineReviewPlatform OnlineReviewPlatform?

  // Responses
  responses FeedbackResponse[]

  // Links generated per bill (when config is set, links use this config)
  feedbackLinks FeedbackLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@map("feedback_config")
}

model FeedbackQuestion {
  id String @id @default(uuid())

  question String
  // iconType: emoji, number, etc. (Not enum for now)
  iconType String?

  configId String
  config   FeedbackConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([configId])
  @@map("feedback_question")
}

model FeedbackCategory {
  id String @id @default(uuid())

  // Examples: Service, Quality of products, Value for money
  name String

  configId String
  config   FeedbackConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([configId])
  @@map("feedback_category")
}

model HowDidYouHearOption {
  id String @id @default(uuid())

  name String

  configId String
  config   FeedbackConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([configId])
  @@map("how_did_you_hear_option")
}

model FeedbackSelectionOption {
  id String @id @default(uuid())

  label    String
  seq      Int // display order for DnD
  configId String
  config   FeedbackConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  responses FeedbackResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([configId, label])
  @@index([configId])
  @@map("feedback_selection_option")
}

model FeedbackResponse {
  id String @id @default(uuid())

  // Relations
  configId String
  config   FeedbackConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  businessId       String
  customerId       String
  businessCustomer BusinessCustomer @relation(fields: [businessId, customerId], references: [businessId, customerId], onDelete: Cascade)

  // One response per feedback link (one bill = one feedback)
  feedbackLink FeedbackLink?
  transactions Transaction[]

  // Response Data
  rating                   Int?
  comment                  String?
  howDidYouHear            String?
  selectedCategories       String[] // Storing as names for simplicity or could be relation
  selectedSelectionOptions FeedbackSelectionOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([configId])
  @@index([customerId])
  @@index([businessId, rating])
  @@index([businessId, customerId])
  @@map("feedback_response")
}

// One link per bill; created when bill is created. One feedback per link (one bill = one feedback).
model FeedbackLink {
  id String @id @default(uuid())

  // Token for public feedback URL (e.g. /feedback/[token])
  token String @unique @default(uuid())

  // Bill is required: every bill gets a feedback link
  billId String @unique
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  // When business has set feedback config, link uses it for UI/flow
  configId String?
  config   FeedbackConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)

  // At most one response per link (feedback already submitted for this bill)
  feedbackResponseId String?           @unique
  feedbackResponse   FeedbackResponse? @relation(fields: [feedbackResponseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billId])
  @@index([configId])
  @@map("feedback_link")
}
