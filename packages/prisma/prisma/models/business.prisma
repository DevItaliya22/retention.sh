model Business {
  id      String  @id @default(uuid())
  name    String
  slug    String  @unique
  website String?

  defaultPointsName       String    @default("Points")
  defaultCurrencySymbol   String    @default("₹")
  defaultCurrencyCode     String    @default("INR")
  registrationBonusPoints Int       @default(0) // Bonus points when customer registers from loyalty login page
  defaultBranding         Branding?

  // Service toggles: { referral?: boolean, loyalty?: boolean, ... }
  // Missing key = disabled. Add new keys in lib/schemas/service-enabled.ts
  isServiceEnabled Json?

  // Relations
  admins    Admin[]
  cashiers  Cashier[]
  customers BusinessCustomer[]

  memberships     Membership[]
  loyalty         Loyalty?
  feedbackConfig  FeedbackConfig?
  qrs             Qr[]
  scratchCards    ScratchCard[]
  referralProgram ReferralProgram?

  categories Category[]
  skus       Sku[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id])
  @@index([slug])
  @@map("business")
}

// Product/service category for a business (e.g. "Beverages", "Apparel")
// Can have subcategories; SKU links to categoryId only (category or subcategory) for filters/display
model Category {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Subcategories: null parentId = top-level category
  parentId      String?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[] @relation("CategoryHierarchy")

  name        String
  description String?
  sortOrder   Int     @default(0) // display order

  skus Sku[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([parentId])
  @@map("category")
}

// SKU / item the business sells to customers
model Sku {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sku         String // stock-keeping unit code, unique per business (e.g. "COKE-330")
  name        String
  description String?
  price       Float? // unit price
  unit        String? // e.g. "piece", "kg", "liter"
  isActive    Boolean @default(true)

  billLineItems       BillLineItem[]
  loyaltyRewardStages LoyaltyRewardStage[] // FREE_ITEM reward stages referencing this SKU

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([categoryId])
  @@map("sku")
}
