enum MessageChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum MessageSource {
  LOYALTY_OTP
  LOYALTY_REMINDER
  LOYALTY_EARN
  LOYALTY_EXPIRE
  FEEDBACK_LINK
  NEGATIVE_FEEDBACK_ALERT
  REFERRAL_REMINDER
  REFERRAL_CLAIM
  MEMBERSHIP_ENROLLMENT
  CAMPAIGN_APPLIED
  CAMPAIGN_BROADCAST
  QR_REWARD_EXPIRE
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

model MessageLog {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  channel   MessageChannel
  recipient String
  subject   String?
  body      String

  source   MessageSource
  sourceId String?

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  scheduledAt DateTime?

  status    MessageStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([businessId])
  @@index([status])
  @@index([source])
  @@index([campaignId])
  @@map("message_log")
}
