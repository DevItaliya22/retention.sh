model Membership {
  id String @id @default(uuid())

  // Business Connection
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Basic info
  name        String  @default("")
  description String?

  // Status
  status MembershipStatus @default(DRAFT)

  // Branding
  brandingId String?   @unique
  branding   Branding? @relation(fields: [brandingId], references: [id], onDelete: SetNull, map: "membership_branding_fkey")

  // Marketing
  marketingSlug String @unique @default(uuid())

  // Pricing
  platformConvenienceFee Float @default(0)
  paymentGatewayCharge   Float @default(0)
  businessReceives       Float @default(0)
  totalPrice             Float @default(0) // Calculated: convenienceFee + gateway + receives

  // Terms
  termsAndConditions TermsAndConditions[]

  // QR Config
  qrImage String? // URL or path to QR image
  qrData  String? // Link or encrypted data encoded in QR

  // Benefits relation
  membershipBenefits MembershipBenefit[]

  // Channels
  whatsappEnabled Boolean @default(false)
  emailEnabled    Boolean @default(false)
  smsEnabled      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  qrs                 Qr[]
  membershipActions   MembershipAction[]
  customerMemberships CustomerMembership[]

  @@index([businessId])
  @@index([marketingSlug])
  @@map("membership")
}

// Who bought / is enrolled in a membership. Links a business customer to a membership with validity window.
model CustomerMembership {
  id String @id @default(uuid())

  businessId       String
  customerId       String
  businessCustomer BusinessCustomer @relation(fields: [businessId, customerId], references: [businessId, customerId], onDelete: Cascade)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, customerId, membershipId])
  @@index([membershipId])
  @@index([businessId, customerId])
  @@map("customer_membership")
}

model MembershipBenefit {
  id String @id @default(uuid())

  type MembershipBenefitType

  // For PERCENTAGE_DISCOUNT
  percentage          Float?
  maxRedeemableAmount Float?

  // For CASH_DISCOUNT
  amount            Float?
  minPurchaseAmount Float?

  // For FREE_ITEM
  item String? // For free item description

  // For LOYALTY_BONUS
  points Int?

  // Common for discounts
  appliesTo     BenefitAppliesTo? @default(ENTIRE_PURCHASE)
  specificItems String[] // List of items if appliesTo is SPECIFIC_ITEMS

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([membershipId])
  @@map("membership_benefit")
}

// This is like redirect or something like that 
model MembershipAction {
  id String @id @default(uuid())

  platform String
  label    String
  url      String

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([membershipId])
  @@map("membership_action")
}
