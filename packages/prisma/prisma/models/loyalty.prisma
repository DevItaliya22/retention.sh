model Loyalty {
  id String @id @default(uuid())

  // Business Connection (One business has one loyalty)
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Branding
  brandingId String?   @unique
  branding   Branding? @relation(fields: [brandingId], references: [id], onDelete: SetNull, map: "loyalty_branding_fkey")

  // Form STEP 2 - Cashback Settings
  earningPercentage          Float   @default(0) // Customer earns X%
  earnPointsOnPaidAmountOnly Boolean @default(true) // When redeeming: earn points on amount paid (finalAmount); if false, earn on full bill amount
  cashbackInFinalAmount      Boolean @default(false) // Cashback available in final amount? means if there is a bill of 1000 and 10% cashback then the customer will receive 100 points now if next time he comes and make another bill of 1000 then he redeem the 100 points from pre back , so the bill amount should be 1000 but points should only be given on 900 , if admin wants to give to 1000 then its this variable shouyld be true 
  cashbackBranding           String? // e.g., "cookies", "chillies"
  minPurchaseForEarning      Float   @default(0) // Minimum purchase for earning cashback
  minPurchaseForRedemption   Float   @default(0) // Minimum purchase for using loyalty coupon

  // Form STEP 3 - Limits
  upperLimitBillAmount      Float? // Upper limit on bill amount
  upperLimitClaimableAmount Float? // Upper limit on claimable amount

  // Form STEP 4 - Terms & Conditions
  termsAndConditions TermsAndConditions[]

  // Form STEP 5 - Points Configuration
  pointReminderDays Int? // Point reminder after how many days
  pointExpiryDays   Int? // Points expire after how many days

  // Form STEP 6 - Communication Channels
  whatsappEnabled Boolean @default(false)
  emailEnabled    Boolean @default(false)
  smsEnabled      Boolean @default(false)

  // Relations
  tiers LoyaltyTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  qrs Qr[]

  @@index([businessId])
  @@map("loyalty")
}

model LoyaltyTier {
  id String @id @default(uuid())

  name      String // e.g. "Gold", "Silver"
  rank      Int // 1- highest rank , 2- second highest rank , 3- third highest rank , etc.
  minPoints Int    @default(0) // Entry criteria

  rewards String[] // Simple text rewards for now

  // Relation to Loyalty
  loyaltyId String
  loyalty   Loyalty @relation(fields: [loyaltyId], references: [id], onDelete: Cascade)

  // Terms
  termsAndConditions TermsAndConditions[]

  // Customers in this tier
  customers BusinessCustomer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loyaltyId])
  @@map("loyalty_tier")
}

model PointsTransaction {
  id String @id @default(uuid())

  businessId       String
  customerId       String
  businessCustomer BusinessCustomer @relation(fields: [businessId, customerId], references: [businessId, customerId], onDelete: Cascade)

  amount                Int
  type                  TransactionType
  source                TransactionSource
  sourceId              String? // Generic source reference; when source=BILL use billId
  billId                String? // FK to Bill when source=BILL (earned/redeemed on this bill)
  bill                  Bill?                        @relation(fields: [billId], references: [id], onDelete: SetNull)
  expiresAt             DateTime?
  metadata              Json?
  balanceAfter          Int                          @default(0)
  redemptionAllocations PointsRedemptionAllocation[]
  earnedBuckets         PointsBucket[]

  createdAt DateTime @default(now())

  @@index([businessId, customerId])
  @@index([businessId, customerId, createdAt])
  @@index([source])
  @@index([source, sourceId])
  @@index([billId])
  @@index([type])
  @@index([expiresAt])
  @@map("points_transaction")
}

model PointsBucket {
  id String @id @default(uuid())

  businessId       String
  customerId       String
  businessCustomer BusinessCustomer @relation(fields: [businessId, customerId], references: [businessId, customerId], onDelete: Cascade)

  earnedTransactionId String
  earnedTransaction   PointsTransaction @relation(fields: [earnedTransactionId], references: [id], onDelete: Cascade)

  originalAmount        Int
  remainingAmount       Int
  expiresAt             DateTime
  status                String                       @default("ACTIVE") // ACTIVE | EXPIRED | CONSUMED
  redemptionAllocations PointsRedemptionAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, customerId, expiresAt])
  @@index([remainingAmount])
  @@map("points_bucket")
}

model PointsRedemptionAllocation {
  id String @id @default(uuid())

  redeemTransactionId String
  redeemTransaction   PointsTransaction @relation(fields: [redeemTransactionId], references: [id], onDelete: Cascade)

  bucketId String
  bucket   PointsBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  amount Int

  createdAt DateTime @default(now())

  @@index([redeemTransactionId])
  @@index([bucketId])
  @@map("points_redemption_allocation")
}
