model Customer {
    id String @id @default(uuid())

    // Business Connection
    businesses BusinessCustomer[]

    // Required - Phone number (unique identifier)
    phoneNumber String @unique

    // Optional fields
    name  String?
    email String?

    // Optional Address (embedded fields)
    addressLine1 String?
    addressLine2 String?
    city         String?
    state        String?
    country      String?
    postalCode   String?

    // Referral slug - unique per customer for sharing
    referralSlug String @unique @default(uuid())
    referredById String?
    referredBy   Customer?  @relation("CustomerReferral", fields: [referredById], references: [id], onDelete: SetNull)
    // Customers this person has referred
    referrals Customer[] @relation("CustomerReferral")
    // Referral logs (for tracking/rewards)
    referralLogs ReferralLog[] @relation("ReferrerLog")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([phoneNumber])
    @@index([referralSlug])
    @@index([referredById])
    @@map("customer")
}

// This is bussiness customer relation , all the data related to customer for that particular bussiness will come in this thing
model BusinessCustomer {
    businessId String
    business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

    customerId String
    customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

    currentpoints      Int   @default(0)
    storeCredit Float @default(0)

    feedbackResponses     FeedbackResponse[]
    scratchCardResponses  ScratchCardResponse[]
    bills                 Bill[]

    currentTierId String?
    currentTier   LoyaltyTier? @relation(fields: [currentTierId], references: [id], onDelete: SetNull)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    
    @@id([businessId, customerId])
    @@map("business_customer")
    @@index([currentTierId])
}
