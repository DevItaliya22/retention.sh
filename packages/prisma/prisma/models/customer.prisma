// ========================================================================
// CUSTOMER
// ========================================================================
// A customer is a person who shops at one or more businesses.
// The User table holds auth credentials (email is number@dy.com for customers,
// used only for auth identification). The actual customer email is stored here.
//
// A customer can belong to multiple businesses via BusinessCustomer (pivot).
// All business-specific data (points, tier, bills, etc.) lives on that pivot.
// ========================================================================

model Customer {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Customer's real email (for communication).
  // The User.email is a placeholder (number@dy.com) for auth only.
  email String

  // Optional address fields
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?

  // Business connections (customer can belong to multiple businesses)
  businesses BusinessCustomer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer")
}

// ========================================================================
// BUSINESS–CUSTOMER PIVOT
// ========================================================================
// All data specific to a customer within a particular business.
// Composite PK: (businessId, customerId).
//
// Loyalty tracking fields:
//   pointsBalance  — current redeemable points (denormalized from PointsTransaction).
//   lifetimeSpend  — cumulative bill total (denormalized; used for TIER placement).
//   visitCount     — total qualifying visits (denormalized; used for VISIT_MADE).
//   lastVisitAt    — timestamp of last qualifying visit (used for visit interval check).
//   currentTierId  — FK to the customer's active LoyaltyTier (for TIER type).
//
// These denormalized fields are updated by the billing/loyalty service on each
// transaction. Source of truth is PointsTransaction + Bill tables.
// ========================================================================

model BusinessCustomer {
  slugId String @unique @default(uuid()) // URL-safe identifier for API endpoints

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // ── Referral ───────────────────────────────────────────────────────────
  // Unique referral slug for this customer within this business.
  referralSlug String @unique @default(uuid())

  // Who referred this customer (business-specific).
  referredByBusinessId String?
  referredByCustomerId String?
  referredBy           BusinessCustomer? @relation("BusinessCustomerReferral", fields: [referredByBusinessId, referredByCustomerId], references: [businessId, customerId], onDelete: SetNull)

  // Customers this person has referred (business-specific).
  referrals BusinessCustomer[] @relation("BusinessCustomerReferral")

  // Referral tracking logs.
  referralLogs ReferralLog[]

  // ── Tags & Status ─────────────────────────────────────────────────────
  tags          String[]
  isBlocked     Boolean  @default(false)
  blockedReason String?

  // ── Loyalty Tracking (denormalized — updated on each transaction) ──────
  // Current redeemable points balance.
  // Source of truth: SUM(PointsTransaction.amount) for this customer.
  pointsBalance Int @default(0)

  // Cumulative bill total across all purchases (₹). Pre-loyalty total per bill.
  // Used by TIER loyalty type for tier placement.
  // Source of truth: SUM(Bill.finalAmount) for this customer.
  lifetimeSpend Float @default(0)

  // Total qualifying visits (incremented per bill, respecting visit interval).
  // Used by VISIT_MADE loyalty type.
  visitCount Int @default(0)

  // Timestamp of last qualifying visit (used for visit interval check).
  // Updated when visitCount is incremented.
  lastVisitAt DateTime?

  // Current tier for TIER loyalty type. Null if not using tiers.
  currentTierId String?
  currentTier   LoyaltyTier? @relation(fields: [currentTierId], references: [id], onDelete: SetNull)

  // Cumulative cashback (₹) ever given to this customer at this business.
  // Updated only for CASHBACK and TIER loyalty types. Source of truth: CashbackTransaction.
  totalCashbackEarned Float @default(0)

  // ── Transaction & Activity Relations ───────────────────────────────────
  pointTransactions    PointsTransaction[]
  cashbackTransactions CashbackTransaction[]
  feedbackResponses    FeedbackResponse[]
  scratchCardResponses ScratchCardResponse[]
  bills                Bill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([businessId, customerId])
  @@index([referralSlug])
  @@index([referredByBusinessId, referredByCustomerId])
  @@index([currentTierId])
  @@index([slugId])
  @@index([customerId])
  @@map("business_customer")
}
