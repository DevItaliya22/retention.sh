model Customer {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email String // This is the email of the customer , it will be used for sending emails to the custome r, the email in the User table is for the admin and cashier only , we will not use it for the customer , the email will be number@dy.com in user table for just sake of making user and identification purpose

  // Optional Address fields
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?

  // Business Connection (Customer can belong to multiple businesses)
  businesses BusinessCustomer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer")
}

// This is bussiness customer relation , all the data related to customer for that particular bussiness will come in this thing
model BusinessCustomer {
  slugId String @unique @default(uuid()) // this id will be used for the slug in the url and for the api endpoints 

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Referral slug - unique per business-customer for sharing
  referralSlug String @unique @default(uuid())

  // Referred by other business customer (business-specific)
  referredByBusinessId String?
  referredByCustomerId String?
  referredBy           BusinessCustomer? @relation("BusinessCustomerReferral", fields: [referredByBusinessId, referredByCustomerId], references: [businessId, customerId], onDelete: SetNull)

  // Business customers this person has referred (business-specific)
  referrals BusinessCustomer[] @relation("BusinessCustomerReferral")

  // Referral logs (for tracking/rewards) - business-specific
  referralLogs ReferralLog[]

  tags          String[]
  isBlocked     Boolean  @default(false)
  blockedReason String?

  pointsBalance     Int                 @default(0)
  pointTransactions PointsTransaction[]
  pointsBuckets     PointsBucket[]

  feedbackResponses    FeedbackResponse[]
  scratchCardResponses ScratchCardResponse[]
  bills                Bill[]

  currentTierId String?
  currentTier   LoyaltyTier? @relation(fields: [currentTierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([businessId, customerId])
  @@index([referralSlug])
  @@index([referredByBusinessId, referredByCustomerId])
  @@index([currentTierId])
  @@index([slugId])
  @@index([customerId])
  @@map("business_customer")
}
