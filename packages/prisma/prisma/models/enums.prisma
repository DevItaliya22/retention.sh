enum LoyaltyType {
  CASHBACK // Direct discount on same bill, no points
  TIER // Lifetime spending tiers, points earned
  AMOUNT_SPENT // Bill-specific amount thresholds, points earned
  VISIT_MADE // Visit count rewards, points earned
}

enum LoyaltyRewardType {
  FREE_ITEM
  PERCENTAGE_DISCOUNT
  CASH_DISCOUNT
}

enum VisitIntervalUnit {
  MINUTE // 1-60
  HOUR // 1-23
  DAY // 1-31
  WEEK // 1-4
  MONTH // 1-12
}

enum LoyaltyMessageType {
  FIRST_PURCHASE // Sent on first purchase
  EXPIRE // Sent when points are about to expire
  REMINDER // Sent as point reminder
  SUBSEQUENT_PURCHASE // Sent on subsequent purchases
  MEMBERSHIP_JOIN // Added for membership
}

enum MembershipBenefitType {
  CASH_DISCOUNT
  PERCENTAGE_DISCOUNT
  FREE_ITEM
  LOYALTY_BONUS
  NO_DISCOUNT
}

enum BenefitAppliesTo {
  ENTIRE_PURCHASE
  SPECIFIC_ITEMS
}

enum QrBenefitType {
  CASH_DISCOUNT
  PERCENTAGE_DISCOUNT
  FREE_ITEM
  LOYALTY_BONUS
}

enum ReferalBenefitType {
  AMOUNT_CASHBACK
  FREE_ITEM_ON_NEXT_PURCHASE
}

enum MembershipStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum FeedbackTiming {
  IMMEDIATELY
  AFTER_DELAY
}

enum FeedbackCollectionChannel {
  WHATSAPP
  SMS
  EMAIL
  CASHIER_PORTAL
}

enum OnlineReviewPlatform {
  GOOGLE
  INSTAGRAM
  FACEBOOK
  ZOMATO
  OTHER
}

enum CollectionChannel {
  WHATSAPP
  LANDING_PAGE
}

enum CustomerTargetGroup {
  NEW_CUSTOMERS
  NEW_AND_EXISTING
  EXISTING_CUSTOMERS_ONLY
}

enum RedemptionLimit {
  ONCE
  MULTIPLE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
}

enum CampaignChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum AutoCampaignTrigger {
  BIRTHDAY
  ANNIVERSARY
  FIRST_PURCHASE
  WIN_BACK
  MEMBERSHIP_EXPIRY
  POINTS_EXPIRY
}

// Transaction type — what happened.
enum TransactionType {
  EARNED
  REDEEMED
  EXPIRED
  GIFTED
  ADJUSTMENT
  REFUNDED
}

// What triggered the point transaction — the origin event.
enum TransactionSource {
  BILL // Points from a purchase/bill
  FEEDBACK // Points for providing feedback
  SCRATCH_CARD // Points from scratch card game
  CAMPAIGN // Points from marketing campaign
  REFERRAL // Points from referral program
  REGISTRATION // Registration bonus (Business.registrationBonusPoints)
  MANUAL_ADJUSTMENT // Admin manual adjustment
}

// Value kind for unified Transaction — which wallet bucket.
enum TransactionValueKind {
  CASHBACK // Amount in ₹ → wallet.cashbackBalance
  AMOUNT_SPENT_POINTS // Points → wallet.amountSpentBalance
  VISIT_POINTS // Points → wallet.visitPointsBalance
  FREE_ITEM // Free item (referral) → wallet.freeItems
}

enum WalletType {
  POINTS
  STORE_CREDIT
}

enum Role {
  CUSTOMER
  ADMIN
  CASHIER
}
