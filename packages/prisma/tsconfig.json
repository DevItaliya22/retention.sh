{
  "extends": "@reelo/typescript-config/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@zeropaper/prisma/*": ["./src/*"]
    },
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
